# Copy to .env.local and fill in. Never commit real values. Names and uses: docs/DESIGN.md, Appendix.

# Browser (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_DEMO=            # 1 shows the user switcher so two phones can act as two seeded people

# Server and scripts only
SUPABASE_SERVICE_ROLE_KEY=   # ingestion and agent writes; bypasses RLS
ANTHROPIC_API_KEY=           # Deep Agent (read by @langchain/anthropic)
AGENT_MODEL=                 # optional, provider:model
COSTAR_KIT_ZIP=              # path to the kit zip, or...
COSTAR_KIT_URL=              # ...a URL to it
COSTAR_ZIP_PASSWORD=
APARTMENTS_COM_ENRICH=       # on | off, image enrichment kill switch
VEXCEL_API_KEY=              # aerial evidence and Ducktect
# LangSmith traces (optional): variable names still to be confirmed in the design doc [verify]
